{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notevoro",
  "version": "2.0.0",
  "identifier": "com.notevoro.app",
  "build": {
    "beforeDevCommand": "yarn --cwd ../frontend dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "yarn --cwd ../frontend build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Notevoro",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 680,
        "titleBarStyle": "Overlay",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi", "nsis", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© Notevoro",
    "category": "Productivity",
    "shortDescription": "Local-first knowledge, productivity and AI workspace",
    "longDescription": "Notevoro — Unified Spaces. Your vault of Markdown files stays on your device; Notevoro is the interface and intelligence layer."
  },
  "plugins": {}
}
